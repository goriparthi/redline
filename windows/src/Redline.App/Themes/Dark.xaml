<!-- The dark palette. Generated from Theming/DesignSystem.cs; keys and values must match it exactly. -->
<!-- Each token is a Color and a frozen brush named <key>.Brush, for DynamicResource. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="po">
  <sys:String x:Key="RL.Theme.Name">Dark</sys:String>

  <!-- Surface -->
  <Color x:Key="RL.Surface.Ground">#FF0B0D10</Color>
  <SolidColorBrush x:Key="RL.Surface.Ground.Brush" Color="#FF0B0D10" po:Freeze="True" />
  <Color x:Key="RL.Surface.Raised">#FF171A1F</Color>
  <SolidColorBrush x:Key="RL.Surface.Raised.Brush" Color="#FF171A1F" po:Freeze="True" />
  <Color x:Key="RL.Surface.Sunken">#FF07090B</Color>
  <SolidColorBrush x:Key="RL.Surface.Sunken.Brush" Color="#FF07090B" po:Freeze="True" />
  <Color x:Key="RL.Surface.Overlay">#FF1D2128</Color>
  <SolidColorBrush x:Key="RL.Surface.Overlay.Brush" Color="#FF1D2128" po:Freeze="True" />
  <Color x:Key="RL.Surface.RaisedHover">#FF1D2128</Color>
  <SolidColorBrush x:Key="RL.Surface.RaisedHover.Brush" Color="#FF1D2128" po:Freeze="True" />

  <!-- Ink -->
  <Color x:Key="RL.Ink.Primary">#FFF4F1EA</Color>
  <SolidColorBrush x:Key="RL.Ink.Primary.Brush" Color="#FFF4F1EA" po:Freeze="True" />
  <Color x:Key="RL.Ink.Secondary">#FFA8AEBA</Color>
  <SolidColorBrush x:Key="RL.Ink.Secondary.Brush" Color="#FFA8AEBA" po:Freeze="True" />
  <Color x:Key="RL.Ink.Muted">#FF848A96</Color>
  <SolidColorBrush x:Key="RL.Ink.Muted.Brush" Color="#FF848A96" po:Freeze="True" />
  <Color x:Key="RL.Ink.OnAccent">#FF0B0D10</Color>
  <SolidColorBrush x:Key="RL.Ink.OnAccent.Brush" Color="#FF0B0D10" po:Freeze="True" />

  <!-- Stroke -->
  <Color x:Key="RL.Stroke.Hairline">#FF262A32</Color>
  <SolidColorBrush x:Key="RL.Stroke.Hairline.Brush" Color="#FF262A32" po:Freeze="True" />
  <Color x:Key="RL.Stroke.Border">#FF323843</Color>
  <SolidColorBrush x:Key="RL.Stroke.Border.Brush" Color="#FF323843" po:Freeze="True" />
  <Color x:Key="RL.Stroke.BorderStrong">#FF4A515F</Color>
  <SolidColorBrush x:Key="RL.Stroke.BorderStrong.Brush" Color="#FF4A515F" po:Freeze="True" />

  <!-- State -->
  <Color x:Key="RL.State.Success">#FF32D74B</Color>
  <SolidColorBrush x:Key="RL.State.Success.Brush" Color="#FF32D74B" po:Freeze="True" />
  <Color x:Key="RL.State.Warning">#FFFF9F0A</Color>
  <SolidColorBrush x:Key="RL.State.Warning.Brush" Color="#FFFF9F0A" po:Freeze="True" />
  <Color x:Key="RL.State.Error">#FFFF3B30</Color>
  <SolidColorBrush x:Key="RL.State.Error.Brush" Color="#FFFF3B30" po:Freeze="True" />
  <Color x:Key="RL.State.Offline">#FF848A96</Color>
  <SolidColorBrush x:Key="RL.State.Offline.Brush" Color="#FF848A96" po:Freeze="True" />
  <Color x:Key="RL.State.Unknown">#FF6E7480</Color>
  <SolidColorBrush x:Key="RL.State.Unknown.Brush" Color="#FF6E7480" po:Freeze="True" />

  <!-- Brandmark -->
  <Color x:Key="RL.Brandmark.Signal">#FFFF3B30</Color>
  <SolidColorBrush x:Key="RL.Brandmark.Signal.Brush" Color="#FFFF3B30" po:Freeze="True" />
  <Color x:Key="RL.Brandmark.Money">#FF32D74B</Color>
  <SolidColorBrush x:Key="RL.Brandmark.Money.Brush" Color="#FF32D74B" po:Freeze="True" />

  <!-- Accent -->
  <Color x:Key="RL.Accent.Codex">#FF45C4D4</Color>
  <SolidColorBrush x:Key="RL.Accent.Codex.Brush" Color="#FF45C4D4" po:Freeze="True" />
  <Color x:Key="RL.Accent.Anthropic">#FFD9A05B</Color>
  <SolidColorBrush x:Key="RL.Accent.Anthropic.Brush" Color="#FFD9A05B" po:Freeze="True" />
  <Color x:Key="RL.Accent.Ollama">#FF9888D4</Color>
  <SolidColorBrush x:Key="RL.Accent.Ollama.Brush" Color="#FF9888D4" po:Freeze="True" />
  <Color x:Key="RL.Accent.Neutral">#FFA8AEBA</Color>
  <SolidColorBrush x:Key="RL.Accent.Neutral.Brush" Color="#FFA8AEBA" po:Freeze="True" />
</ResourceDictionary>
