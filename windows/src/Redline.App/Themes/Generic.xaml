<!-- Default templates for the button-based components. Colours come through DynamicResource, -->
<!-- so they follow ThemeManager and any subtree pinned to one theme. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Redline.App.Components">

  <Style x:Key="RL.FocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-2" CornerRadius="7" BorderThickness="1.5" BorderBrush="{DynamicResource RL.Ink.Primary.Brush}" Opacity="0.7" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- RLInlineButton: icon and word, secondary ink, a sunken tint on hover -->
  <Style TargetType="{x:Type c:RLInlineButton}">
    <Setter Property="Foreground" Value="{DynamicResource RL.Ink.Secondary.Brush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource RL.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type c:RLInlineButton}">
          <Border x:Name="Bg" Background="Transparent" CornerRadius="5" Padding="8,4">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="IconText" Text="{TemplateBinding Icon}" FontFamily="{DynamicResource RL.Font.Icons}"
                         FontSize="10" FontWeight="SemiBold" Margin="0,0,4,0" VerticalAlignment="Center"
                         Foreground="{TemplateBinding Foreground}" />
              <TextBlock Text="{TemplateBinding Title}" FontFamily="{DynamicResource RL.Font.UI}" FontSize="11"
                         VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
              <Setter TargetName="IconText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Icon" Value="">
              <Setter TargetName="IconText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource RL.Surface.Sunken.Brush}" />
              <Setter Property="Foreground" Value="{DynamicResource RL.Ink.Primary.Brush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bg" Property="Opacity" Value="0.8" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- RLSegmentButton: sunken when idle, a signal tint and edge when chosen -->
  <Style TargetType="{x:Type c:RLSegmentButton}">
    <Setter Property="Foreground" Value="{DynamicResource RL.Ink.Muted.Brush}" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource RL.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type c:RLSegmentButton}">
          <Grid>
            <Border x:Name="Idle" CornerRadius="5" Background="{DynamicResource RL.Surface.Sunken.Brush}" />
            <Border x:Name="Fill" CornerRadius="5" Background="{DynamicResource RL.Brandmark.Signal.Brush}" Opacity="0.2" Visibility="Collapsed" />
            <Border x:Name="Edge" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource RL.Brandmark.Signal.Brush}" Opacity="0.55" Visibility="Collapsed" />
            <TextBlock Text="{TemplateBinding Content}" FontFamily="{DynamicResource RL.Font.Mono}" FontSize="12" FontWeight="Medium"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Idle" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Fill" Property="Visibility" Value="Visible" />
              <Setter TargetName="Edge" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{DynamicResource RL.Ink.Primary.Brush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
