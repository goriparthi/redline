<Window
    x:Class="RedLine.App.DashboardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The chart, the tiles and the model mix are all built in code-behind: the number of
         bars is whatever the engine published, and a DataTemplate would need bindable row
         types the XAML generator then tries to assign to. Same reason as SettingsWindow.

         Dark on the root, because the ground is carbon and the stock controls have to match. -->
    <Grid x:Name="Root" Background="#0B0D10" RequestedTheme="Dark">
        <Grid Margin="24,20,24,20" RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header, with the range this is all about on the same line -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="REDLINE" FontSize="11" FontWeight="SemiBold"
                               Foreground="#848A96" CharacterSpacing="220" />
                    <TextBlock Text="Dashboard" FontSize="20" FontWeight="SemiBold"
                               Foreground="#F4F1EA" />
                </StackPanel>
                <ComboBox Grid.Column="1" x:Name="RangePicker" Width="130"
                          VerticalAlignment="Bottom" />
            </Grid>

            <!-- What the published snapshot says right now, beside what the history says -->
            <Grid Grid.Row="1" x:Name="Tiles" ColumnSpacing="12" />

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Panels" Spacing="20" Padding="0,2,14,2" />
            </ScrollViewer>

            <TextBlock Grid.Row="3" x:Name="FooterText" FontSize="11" Foreground="#848A96"
                       TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Window>
