<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net9.0 with WindowsAppSDK 1.8 and H.NotifyIcon 2.3.2, which is the combination that
         actually agrees: the tray library's 2.4 line is net10 only, and 1.6's XAML compiler
         does not understand net10 at all. -->
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>RedLine.App</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged by default: that is the zip a beta tester unpacks, runs and deletes.
         Build with -p:WindowsPackageType=MSIX for the installer, which is the only packaging
         that can carry the Windows 11 widget. -->
    <WindowsPackageType Condition="'$(WindowsPackageType)' == ''">None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The exe's own icon, as Explorer and the taskbar show it -->
    <ApplicationIcon>../../Resources/RedLine.ico</ApplicationIcon>
    <!-- Generated XAML code-behind trips analyzers that are none of our business -->
    <NoWarn>$(NoWarn);CS8305</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4948" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.3.2" />
    <!-- For System.Drawing.Icon, which is what TaskbarIcon.Icon actually is -->
    <PackageReference Include="System.Drawing.Common" Version="9.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../RedLine.Core/RedLine.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The same icon the executable carries, next to the app so the tray can load an HICON
         from it at runtime -->
    <Content Include="../../Resources/RedLine.ico" Link="Assets/RedLine.ico"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Only for the packaged build. An unpackaged app has no manifest to honour, and the
       tiles would be four files copied next to the exe for nothing. -->
  <ItemGroup Condition="'$(WindowsPackageType)' == 'MSIX'">
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
    <Content Include="Images\**" />
  </ItemGroup>
  <!-- The engine, flattened next to the app. RedLine.Core looks beside the executable before
       it looks at PATH, and inside a package there is nowhere else for it to be. Pass
       -p:RedlineEngine=<folder> from the build that already produced it. -->
  <ItemGroup Condition="'$(RedlineEngine)' != ''">
    <Content Include="$(RedlineEngine)\**" Link="%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
