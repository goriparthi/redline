<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- macOS refuses to register an unsandboxed widget extension, so the sandbox stays.
         No App Group: a capability entitlement needs a provisioning profile, which blocks
         Developer ID signing and notarization. The app writes the snapshot into this
         extension's own container, which a sandboxed process can always read. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
</dict>
</plist>
