<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Intentionally empty. Redline is not sandboxed, and it needs no special capability:
         it reads files in the user's own home directory. An App Group was declared here once,
         but a capability entitlement requires a provisioning profile, which forces development
         signing and makes the build unnotarizable. The widget reads the snapshot from its own
         container instead, which needs no entitlement at all. -->
</dict>
</plist>
